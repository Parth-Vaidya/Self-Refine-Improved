# Copy locally to .env only if you do not already have one. Never commit real values.
HF_TOKEN=your_hugging_face_token_here
HF_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
HF_PROVIDER=nscale
HF_TIMEOUT=60
HF_MAX_RETRIES=2
# Optional hosted Groq backup. Keep the real key only in your local .env.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_ID=openai/gpt-oss-20b
GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=0
# Groq transport retries are disabled; legacy setting retained for compatibility.
# Optional gap between Groq requests; zero disables automatic pacing.
GROQ_MIN_INTERVAL_SECONDS=0
# true enables fallback for C refinement; false preserves strict comparisons.
HF_GROQ_FALLBACK=false
LLM_ENGINE=gemini-1.5-flash
# Existing adapter maps this alias to gemini-3.5-flash-lite. Verify original-model access.
GEMINI_API_KEY=your_gemini_key_here
# OPENAI_API_KEY=your_openai_key_here
# SR_GENERATION_MODEL=gemini-1.5-flash
# SR_FEEDBACK_MODEL=gemini-1.5-flash
# SR_MEASUREMENT_MODEL=gemini-1.5-flash
